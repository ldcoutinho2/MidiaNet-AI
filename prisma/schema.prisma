generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SocialPlatform {
  INSTAGRAM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INACTIVE
}

model User {
  id                String            @id @default(cuid())
  name              String?
  email             String            @unique
  passwordHash      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  sessions          Session[]
  strategicProfile  StrategicProfile?
  socialAccounts    SocialAccount[]
  contents          Content[]
  contentDrafts      ContentDraft[]
  events            Event[]
  subscription      Subscription?
  payments          Payment[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StrategicProfile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  profileDescription       String
  desiredOutcome           String
  instagramProfileUrl      String?
  businessType             String?
  niche                    String?
  offer                    String?
  objective                String?
  secondaryObjectives      Json?
  conversionGoal           String?
  monetization             String?
  audience                 String?
  audienceAge              String?
  audienceGender           String?
  audienceLocation         String?
  audienceInterests        String?
  audiencePainPoints       String?
  location                 String?
  appearsOnCamera          Boolean?
  availableMinutesPerDay   Int?
  availableDaysPerWeek     Int?
  postingFrequency         String?
  contentStyle             String?
  contentPreferences       Json?
  contentAvoid             String?
  brandPersonality         String?
  desiredPositioning       String?
  referenceProfiles        String?
  competitors              String?
  differentiators          String?
  currentChallenges        String?
  salesFunnel              String?
  ninetyDayGoal            String?
  successDefinition        String?
  constraints              String?
  onboardingCompletedAt    DateTime?
  aiProfile                Json?
  aiAnalyzedAt             DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id              String         @id @default(cuid())
  userId          String
  platform        SocialPlatform
  platformUserId  String
  username        String?
  accessToken     String?
  tokenExpiresAt  DateTime?
  connectedAt     DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricSnapshots MetricSnapshot[]
  contents        Content[]

  @@unique([platform, platformUserId])
  @@index([userId])
}

model MetricSnapshot {
  id              String        @id @default(cuid())
  socialAccountId String
  capturedAt      DateTime      @default(now())
  followers       Int?
  reach           Int?
  views           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  saves           Int?
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId, capturedAt])
}

enum ContentDraftStatus {
  IDEA
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHED
}

model ContentDraft {
  id                  String            @id @default(cuid())
  userId              String
  scheduledAt         DateTime?
  publishedAt         DateTime?
  status              ContentDraftStatus @default(IDEA)
  dayLabel            String?
  timeLabel            String?
  format              String
  role                String?
  objective           String?
  title               String
  topic               String?
  hook                String?
  script              String?
  caption             String?
  visualDirection     String?
  cta                 String?
  carouselSlides      Json?
  conversationHistory Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  approvedAt          DateTime?
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, scheduledAt])
}

model Content {
  id                String         @id @default(cuid())
  userId            String
  socialAccountId   String
  platformContentId String?
  type              String?
  caption           String?
  publishedAt       DateTime?
  reach             Int?
  views             Int?
  likes             Int?
  comments          Int?
  shares            Int?
  saves             Int?
  createdAt         DateTime       @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccount     SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([userId, publishedAt])
  @@index([socialAccountId, publishedAt])
}

model Event {
  id           String   @id @default(cuid())
  userId       String?
  name         String
  occurredAt   DateTime @default(now())
  anonymousId  String?
  metadata     Json?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, occurredAt])
  @@index([userId, occurredAt])
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  provider              String?
  providerSubscriptionId String?            @unique
  status                SubscriptionStatus @default(INACTIVE)
  plan                  String?
  currentPeriodEnd      DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id               String    @id @default(cuid())
  userId           String
  provider          String?
  providerPaymentId String?  @unique
  amountCents       Int
  currency          String    @default("BRL")
  status            String
  createdAt         DateTime  @default(now())
  paidAt            DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
